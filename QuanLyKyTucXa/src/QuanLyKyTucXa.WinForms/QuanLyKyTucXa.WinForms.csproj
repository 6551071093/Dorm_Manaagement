<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuanLyKyTucXa.Application\QuanLyKyTucXa.Application.csproj" />
    <ProjectReference Include="..\QuanLyKyTucXa.Domain\QuanLyKyTucXa.Domain.csproj" />
    <ProjectReference Include="..\QuanLyKyTucXa.Infrastructure\QuanLyKyTucXa.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Forms\Contracts\" />
    <Folder Include="Forms\Utilities\" />
    <Folder Include="Forms\Invoices\" />
    <Folder Include="Forms\Incidents\" />
    <Folder Include="Forms\Reports\" />
    <Folder Include="Forms\Users\" />
    <Folder Include="Forms\Main\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- Partial classes share the main form's resource; they are not separate designer forms. -->
  <ItemGroup>
    <EmbeddedResource Remove="Forms\Rooms\FrmPhong.Actions.resx" />
    <EmbeddedResource Remove="Forms\Residents\FrmSinhVien.Actions.resx" />
    <EmbeddedResource Remove="Forms\Residents\FrmSinhVien.Data.resx" />
    <Compile Update="Forms\Rooms\FrmPhong.Actions.cs">
      <SubType>Code</SubType>
      <DependentUpon>FrmPhong.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\Residents\FrmSinhVien.Actions.cs">
      <SubType>Code</SubType>
      <DependentUpon>FrmSinhVien.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\Residents\FrmSinhVien.Data.cs">
      <SubType>Code</SubType>
      <DependentUpon>FrmSinhVien.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Forms\Rooms\RoomEditDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Rooms\RoomEditDialog.Designer.cs">
      <DependentUpon>RoomEditDialog.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\Rooms\RoomEditDialog.resx">
      <DependentUpon>RoomEditDialog.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Forms\Residents\StudentEditDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\Residents\StudentEditDialog.Designer.cs">
      <DependentUpon>StudentEditDialog.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\Residents\StudentEditDialog.resx">
      <DependentUpon>StudentEditDialog.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Forms\Residents\FrmSinhVien.Excel.cs">
      <SubType>Code</SubType>
      <DependentUpon>FrmSinhVien.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Remove="Forms\Residents\FrmSinhVien.Excel.resx" />
    <Compile Update="Forms\Residents\StudentImportPreviewDialog.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Residents\StudentImportPreviewDialog.Designer.cs"><DependentUpon>StudentImportPreviewDialog.cs</DependentUpon></Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Forms\Main\FrmMain.Auth.cs"><SubType>Code</SubType><DependentUpon>FrmMain.cs</DependentUpon></Compile>
    <EmbeddedResource Remove="Forms\Main\FrmMain.Auth.resx" />
    <Compile Update="Forms\Auth\FrmLogin.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Auth\ChangePasswordDialog.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Users\FrmNguoiDung.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Users\UserAccountEditDialog.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Residents\FrmCaNhan.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Residents\ReportIncidentDialog.cs"><SubType>Form</SubType></Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Forms\Auth\RegisterDialog.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Auth\RegisterDialog.Designer.cs"><DependentUpon>RegisterDialog.cs</DependentUpon></Compile>
    <Compile Update="Forms\Auth\ForgotPasswordDialog.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Auth\ForgotPasswordDialog.Designer.cs"><DependentUpon>ForgotPasswordDialog.cs</DependentUpon></Compile>
    <Compile Update="Forms\Auth\RecoveryCodeDialog.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Auth\RecoveryCodeDialog.Designer.cs"><DependentUpon>RecoveryCodeDialog.cs</DependentUpon></Compile>
  </ItemGroup>
</Project>




